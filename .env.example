# OpenAI-compatible API settings (used by BOTH the AI Client and the AI Coach)
# Example: local Ollama (free, open-source model)
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5:7b

# Other examples:
#   Groq (free tier):  AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter:        AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   LM Studio:         AI_BASE_URL=http://localhost:1234/v1

# Optional
AI_TEMPERATURE=0.7
PORT=8000
